# npm run dev creates an ignored .env with a separate local PostgreSQL cluster.
# For an existing database, copy this file to .env and change DATABASE_URL.
DATABASE_URL=postgresql://kwadra_app:CHANGE_ME@127.0.0.1:55432/kwadra
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
# Exact browser origins; no wildcard. Same-origin requests always work.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
# Enable for HTTPS deployment. Never run production over HTTP.
COOKIE_SECURE=false
# Database TLS uses certificate verification when enabled; no rejectUnauthorized=false.
DATABASE_SSL=false
# Canonical URL used by indexable public marketplace pages.
PUBLIC_ORIGIN=http://localhost:3000
# Required for production MFA (64 hexadecimal characters); local dev stores a
# generated key in .local/encryption-key. Back this key up with the database.
ENCRYPTION_KEY=
# Disabled for this delivery. Codes remain in the local development inbox.
EMAIL_DELIVERY_ENABLED=false
# Optional external SMTP. With no SMTP_HOST, development mail stays local.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional private CA for an enterprise SMTP server; certificate verification stays enabled.
SMTP_CA_FILE=
# Google sign-in talks directly to Google; no Firebase Authentication required.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
