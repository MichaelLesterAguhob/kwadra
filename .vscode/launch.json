{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kwadra backend API",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/kwadra-backend-api",
      "program": "${workspaceFolder}/kwadra-backend-api/node_modules/tsx/dist/cli.mjs",
      "args": ["src/dev.ts"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "management (web + API)",
      "cwd": "apps\\management",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "toolArgs": ["--web-port", "8080"]
    },
    {
      "name": "management",
      "cwd": "apps\\management",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "management (profile mode)",
      "cwd": "apps\\management",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "management (release mode)",
      "cwd": "apps\\management",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
